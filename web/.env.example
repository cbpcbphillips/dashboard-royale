# Copy to .env.local and fill in DATABRICKS_TOKEN (never commit it).
# Hostname and HTTP path are not secrets: they identify the workspace and its SQL warehouse.
DATABRICKS_SERVER_HOSTNAME=dbc-b41b9c3d-f914.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/645b0d58be9709fc
# Personal access token: workspace Settings -> Developer -> Access tokens (D-039).
DATABRICKS_TOKEN=
# Unity Catalog location of the gold tables (D-017).
DATABRICKS_CATALOG=royale
